# Copy this file to .env and fill in the values:  cp .env.example .env

# Supabase: Project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Optional (these are the defaults)
# CLIENT_ORIGIN=http://localhost:5173
# ALLOWED_EMAIL_DOMAIN=stonybrook.edu
# REPORT_RADIUS_M=100
# REPORT_COOLDOWN_MIN=30
# STATUS_WINDOW_MIN=90
# STATUS_HALF_LIFE_MIN=15
